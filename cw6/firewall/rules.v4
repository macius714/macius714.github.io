*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING ! -i eth0 -p tcp --dport 80 -j DNAT --to-destination 192.168.1.10:80
-A PREROUTING ! -i eth0 -p tcp --dport 22 -j DNAT --to-destination 192.168.1.20:22
-A POSTROUTING -s 192.168.1.0/24 -o eth2 -j MASQUERADE
COMMIT
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -s 192.168.1.0/24 -p udp --dport 53 -j ACCEPT
-A INPUT -s 192.168.1.0/24 -p tcp --dport 53 -j ACCEPT
-A INPUT -p udp --dport 53 -j DROP
-A INPUT -p tcp --dport 53 -j DROP
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate DNAT -j ACCEPT
-A FORWARD -i eth0 -s 192.168.1.0/24 -j ACCEPT
COMMIT
